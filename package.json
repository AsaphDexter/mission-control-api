{
  "name": "mission-control-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "REST API for Mission Control, a QA Engineering Learning and Practice Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AsaphDexter/mission-control-api.git"
  },
  "bugs": {
    "url": "https://github.com/AsaphDexter/mission-control-api/issues"
  },
  "homepage": "https://github.com/AsaphDexter/mission-control-api#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@fastify/type-provider-typebox": "6.3.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "typebox": "1.4.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "minimatch": "11.0.4"
  }
}
