# PostgreSQL pooled connection (application runtime)
DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=require"

# PostgreSQL direct connection (Prisma migrations)
DIRECT_URL="postgres://USER:PASSWORD@db.prisma.io:5432/postgres?sslmode=require"

# JWT access-token signing key (generate a random 32-byte base64url secret)
JWT_ACCESS_SECRET="REPLACE_WITH_GENERATED_SECRET"

# Application configuration
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info